{
  "name": "bifrost",
  "private": true,
  "version": "0.1.0",
  "description": "Send huge files directly between macOS, Windows and Android: end-to-end encrypted, resumable, no cloud upload.",
  "license": "MIT",
  "homepage": "https://getbifrost.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigMatrixLab/Bifrost.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "dev:ui": "vite --mode mock",
    "build:demo": "vite build --mode mock --base ./ --outDir website/demo --emptyOutDir",
    "build:docs": "node .github/scripts/build-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "cobe": "^2.0.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "18.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
