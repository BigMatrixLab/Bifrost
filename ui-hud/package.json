{
  "name": "bifrost-ui-hud",
  "private": true,
  "version": "0.1.0",
  "description": "Experimental HUD redesign of the Bifrost interface. Self-contained: the main app in ../src is not touched.",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js",
    "dev:ui": "node ../node_modules/vite/bin/vite.js --mode mock",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p .",
    "build": "node ../node_modules/typescript/bin/tsc --noEmit -p . && node ../node_modules/vite/bin/vite.js build",
    "build:mock": "node ../node_modules/vite/bin/vite.js build --mode mock --base ./ --outDir preview --emptyOutDir",
    "build:exe": "powershell -ExecutionPolicy Bypass -File ./build-exe.ps1"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0"
  }
}
